{
  "name": "@bytecode/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "node --import tsx --test src/__tests__/adminQueries.test.ts src/__tests__/cors.test.ts src/__tests__/csrf.test.ts src/__tests__/errorHandler.test.ts src/__tests__/rateLimiters.test.ts src/__tests__/upload.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "admin:create": "tsx src/scripts/createAdmin.ts",
    "permissions:seed": "tsx src/scripts/seedInitialPermissions.ts",
    "cloudinary:cleanup-orphans": "tsx src/scripts/cleanupCloudinaryOrphans.ts",
    "test:smtp": "tsx scripts/test-brevo.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "file-type": "^22.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.16.3",
    "ua-parser-js": "^2.0.9",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.12.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.20.0",
    "@types/ua-parser-js": "^0.7.39",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
